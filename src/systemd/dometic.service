[Unit]
Description=Dometic 39424.602 control daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dometic
EnvironmentFile=/opt/dometic/.env
ExecStart=/opt/dometic/.venv/bin/python -m dometic run
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
